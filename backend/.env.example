PORT=5000
MONGODB_URI=mongodb://localhost:27017/parentalcontrol

# IMPORTANT: Generate a cryptographically secure random string for production.
# Example: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Never use the placeholder value in a production environment.
JWT_SECRET=your_very_long_random_secret_here

# Comma-separated list of allowed CORS origins (e.g. https://yourdomain.com)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:8081
